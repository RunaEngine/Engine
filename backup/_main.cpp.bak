    if(!textures[1].init(speculardir.c_str(), "specular", 1, 0, GL_UNSIGNED_BYTE))
        return -1;

    std::string vertShader = currentDir + "resources/shaders/default.vert";
    std::string fragShader = currentDir + "resources/shaders/default.frag";
    Shader shader;
