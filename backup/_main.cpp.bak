    std::vector<GLuint> lightIndices =
    {
	    0, 1, 2,
	    0, 2, 3,
	    0, 4, 7,
	    0, 7, 3,
	    3, 7, 6,
	    3, 6, 2,
	    2, 6, 5,
	    2, 5, 1,
	    1, 5, 4,
	    1, 4, 0,
