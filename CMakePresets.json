{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-debug",
      "displayName": "msvc-debug",
      "description": "Visual Studio build using Debug",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/Build/${hostSystemName}/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_DEFAULT_BINARY_CACHE": "$env{VCPKG_ROOT}/cache"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "msvc-release",
      "description": "Visual Studio build using Release",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/Build/${hostSystemName}/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug",
      "displayName": "debug",
      "description": "Default build using Debug",
      "binaryDir": "${sourceDir}/Build/${hostSystemName}/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "release",
      "displayName": "release",
      "description": "Default build using Debug",
      "binaryDir": "${sourceDir}/Build/${hostSystemName}/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}
